# Required: create an API key in Google AI Studio and paste it here.
GEMINI_API_KEY=

# Optional backend settings
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:5173

# Optional frontend setting. This must be prefixed with VITE_ to reach the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000
